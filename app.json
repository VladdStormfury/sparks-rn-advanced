{
  "expo": {
    "name": "ShelfScan",
    "slug": "shelfscan",
    "scheme": "shelfscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.formation.shelfscan",
      "infoPlist": {
        "NSCameraUsageDescription": "ShelfScan utilise la caméra pour scanner le code-barres ISBN d'un livre."
      }
    },
    "android": {
      "package": "com.formation.shelfscan",
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-dev-client",
      "./plugins/withVibratePermission",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9b3e48d8-cd41-43de-89c9-dc7a407f7bee"
      }
    },
    "owner": "vladd"
  }
}
